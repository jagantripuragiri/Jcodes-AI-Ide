	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#e6e6e6"
			}
		},
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#6e7681",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": {
				"foreground": "#ff7ad1"
			}
		},
		{
			"scope": ["constant.language", "constant.numeric", "constant.other"],
			"settings": {
				"foreground": "#ffb86c"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#8ce99a"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#f1e05a"
			}
		},
		{
			"scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
			"settings": {
				"foreground": "#66d9ef"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#ff8080"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#79c0ff"
			}
		},
		{
			"scope": ["variable", "variable.other.readwrite", "variable.parameter"],
			"settings": {
				"foreground": "#e6e6e6"
			}
		},
		{
			"scope": ["variable.other.constant", "variable.other.property"],
			"settings": {
				"foreground": "#d2a8ff"
			}
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
			"settings": {
				"foreground": "#9a9a9a"
			}
		},
		{
			"scope": ["keyword.operator"],
			"settings": {
				"foreground": "#ff7ad1"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#e6e6e6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#e6e6e6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#8ce99a"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#ff8080"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#ffffff",
				"background": "#f85149"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#f1e05a",
		"method": "#f1e05a",
		"class": "#66d9ef",
		"type": "#66d9ef",
		"parameter": "#e6e6e6",
		"variable": "#e6e6e6",
		"property": "#d2a8ff",
		"enumMember": "#ffb86c",
		"keyword": "#ff7ad1",
		"comment": "#6e7681"
	}
}
